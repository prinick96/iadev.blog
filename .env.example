SITE_URL=http://localhost:4321
GITHUB_API_BASE_URL=https://api.github.com/
GITHUB_TOKEN=token

# Opcionales: habilitan el registro de posts nuevos durante el build
# PD: Está pensado para que solo funcione en build de prod, es decir,
# yo en local jamás tendré estas variables porque cada run dev lanzaría la comprobación
# así que, en mi caso, solo las tengo definidas en la build de la page en Cloudflare
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Campañas de novedades: solo en builds que deban notificar
# Aunque tengas esto, si no llenas TURSO_DATABASE_URL y TURSO_AUTH_TOKEN
# no se enviará ninguna notificación porque dependemos de consultar turso primero.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_NEWSLETTER_TEMPLATE_ID=

# Para el formulario que recoge la info de la newsletter, es independienete a turso
PUBLIC_BREVO_NEWSLETTER_FORM_URL=
# Captcha, turnstile de Cloudflare
PUBLIC_TURNSTILE_SITE_KEY=
