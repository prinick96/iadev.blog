{
  "name": "iadev-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prepare": "husky",
    "test": "bun test ./src ./.github/workflows/__tests__",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write . && astro check",
    "check:ci": "biome ci . && astro check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tursodatabase/serverless": "1.4.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.4.11",
    "axios": "1.21.1",
    "fontkit": "3.0.0",
    "gpt-tokenizer": "4.1.2",
    "katex": "0.19.1",
    "satteri": "0.11.7",
    "sharp": "0.35.5",
    "vega": "6.4.0",
    "vega-lite": "6.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "typescript": "5.9.3"
  }
}
