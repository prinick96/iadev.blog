---
import { render } from 'astro:content'

import { EXECUTE_POST_NOTIFICATIONS } from '@/core/constants/turso'
import { getAuthorsService } from '@/core/logic/authors/services/index'
import { getCategoriesService } from '@/core/logic/categories/services/index'
import { sendNewPostsNewsletterService } from '@/core/logic/newsletter/services/index'
import { registerNewPostsService } from '@/core/logic/post-notifications/services/index'
import GetPostDetails from '@/core/logic/posts/application/GetPostDetails'
import { getPostSourcesService } from '@/core/logic/posts/services/index'
import SiteLayout from '@/pages/_layouts/SiteLayout/index.astro'
import type { Props } from '@/pages/posts/_types'
import GameOfLifeDemos from '@/ui/assets/posts/el-juego-de-la-vida/index.astro'
import { site } from '@/ui/config/site'
import Post from '@/ui/pages/Post/index.astro'
import { getPostPath } from '@/ui/routes/getPostPath'

export const getStaticPaths = async () => {
  const [posts, categories, authors] = await Promise.all([
    getPostSourcesService.execute(),
    getCategoriesService.execute(),
    getAuthorsService.execute(),
  ])

  if (EXECUTE_POST_NOTIFICATIONS) {
    const slugs = posts.map((source) => source.id)
    const newSlugs = await registerNewPostsService.execute(slugs)
    await sendNewPostsNewsletterService.execute({
      posts,
      new_slugs: newSlugs,
      site_url: site.url,
      get_post_path: getPostPath,
    })
  }

  return posts.map((source) => {
    const details = GetPostDetails.execute({ source, authors, categories })

    return {
      params: { slug: source.id },
      props: { source, details },
    }
  })
}

const { source, details } = Astro.props
const { post, author } = details
const { Content } = await render(source)
---

<SiteLayout title={post.title} description={post.description} article={{ post, author }}>
  <Post {...details}>
    <Content />
  </Post>
  {source.id === 'el-juego-de-la-vida' && <GameOfLifeDemos />}
</SiteLayout>
