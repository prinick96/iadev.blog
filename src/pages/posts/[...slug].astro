---
import { render } from 'astro:content'
import { getAuthorService } from '@/core/logic/author/services/index'
import { getCategoriesService } from '@/core/logic/categories/services/index'
import ConvertPost from '@/core/logic/posts/application/ConvertPost'
import { getPostSourcesService } from '@/core/logic/posts/services/index'
import SiteLayout from '@/pages/_layouts/SiteLayout/index.astro'
import type { Props } from '@/pages/posts/_types'
import Post from '@/ui/pages/Post/index.astro'

export const getStaticPaths = async () => {
  const [posts, categories] = await Promise.all([getPostSourcesService.execute(), getCategoriesService.execute()])
  const author = getAuthorService.execute()

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      author,
      categories: categories.filter((category) =>
        post.data.categories.some((reference) => reference.id === category.id)
      ),
    },
  }))
}

const { post, author, categories } = Astro.props
const { Content } = await render(post)
const convertedPost = ConvertPost.execute(post)
---

<SiteLayout title={convertedPost.title} description={convertedPost.description}>
  <Post post={convertedPost} author={author} categories={categories}>
    <Content />
  </Post>
</SiteLayout>
