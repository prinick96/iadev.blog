---
import { render } from 'astro:content'
import { getAuthorsService } from '@/core/logic/authors/services/index'
import { getCategoriesService } from '@/core/logic/categories/services/index'
import GetPostDetails from '@/core/logic/posts/application/GetPostDetails'
import { getPostSourcesService } from '@/core/logic/posts/services/index'
import SiteLayout from '@/pages/_layouts/SiteLayout/index.astro'
import type { Props } from '@/pages/posts/_types'
import Post from '@/ui/pages/Post/index.astro'

export const getStaticPaths = async () => {
  const [posts, categories, authors] = await Promise.all([
    getPostSourcesService.execute(),
    getCategoriesService.execute(),
    getAuthorsService.execute(),
  ])

  return posts.map((source) => {
    const details = GetPostDetails.execute({ source, authors, categories })

    return {
      params: { slug: source.id },
      props: { source, details },
    }
  })
}

const { source, details } = Astro.props
const { Content } = await render(source)
---

<SiteLayout title={details.post.title} description={details.post.description}>
  <Post {...details}>
    <Content />
  </Post>
</SiteLayout>
