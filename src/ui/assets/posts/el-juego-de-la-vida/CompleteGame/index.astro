---
import Board from '@/ui/assets/posts/el-juego-de-la-vida/Board/index.astro'
---

<template id="life-complete-game-template">
  <Board
    title="Etapa 4: el juego completo"
    description="Dibuja, carga patrones o genera un mundo al azar y deja que las reglas hagan el resto."
    editable
  >
    <label class="life-demo__field">
      <span>Patrón</span>
      <select class="life-demo__select" data-pattern>
        <option value="block">Bloque</option>
        <option value="blinker">Blinker</option>
        <option value="glider" selected>Glider</option>
      </select>
    </label>
    <button class="life-demo__button" type="button" data-action="load">Cargar patrón</button>
    <button class="life-demo__button" type="button" data-action="clear">Vaciar</button>
    <button class="life-demo__button" type="button" data-action="step">Un paso</button>
    <button class="life-demo__button" type="button" data-action="reset">Reiniciar</button>
    <button class="life-demo__button life-demo__button--primary" type="button" data-action="toggle" data-toggle>
      Iniciar
    </button>
    <label class="life-demo__field">
      <span>Densidad inicial</span>
      <select class="life-demo__select" data-density>
        <option value="0.1">10 %</option>
        <option value="0.3" selected>30 %</option>
        <option value="0.7">70 %</option>
      </select>
    </label>
    <button class="life-demo__button" type="button" data-action="random">Generar al azar</button>
    <label class="life-demo__field">
      <span>Velocidad (generaciones/s): <output data-speed-value for="speed">6</output></span>
      <input class="life-demo__speed" id="speed" data-speed type="range" min="1" max="20" value="6" />
    </label>
  </Board>
</template>
