---
import type { Props } from '@/ui/components/PostList/types'
import PostMetrics from '@/ui/components/PostMetrics/index.astro'
import PostThumbnail from '@/ui/components/PostThumbnail/index.astro'
import { getPostPath } from '@/ui/routes/getPostPath'
import { formatDate } from '@/ui/utils/formatDate'
import '@/ui/components/PostList/styles.css'

const { posts, headingLevel = 2 } = Astro.props
const Heading = headingLevel === 3 ? 'h3' : 'h2'
---

{posts.length === 0 ? (
  <p class="post-list__empty">Todavía no hay artículos publicados. La IA sigue pensando.</p>
) : (
  <ul class="post-list">
    {posts.map((post, index) => (
      <li class="post-list__item">
        <div class="post-list__post">
          <span class="post-list__thumbnail">
            <PostThumbnail post={post} loading={index === 0 ? 'eager' : 'lazy'} />
          </span>
          <time class="post-list__date" datetime={post.published_at.toISOString()}>
            {formatDate(post.published_at)}
          </time>
          <div class="post-list__summary">
            <a class="post-list__link" href={getPostPath(post.id)}>
              <Heading class="post-list__title">{post.title}</Heading>
              <p class="post-list__description">{post.description}</p>
            </a>
            <div class="post-list__metrics">
              <PostMetrics post={post} />
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>
)}
