---
import type { Props } from '@/ui/components/icons/PinIcon/types'

const { class: className, label } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d="m16 3 5 5-4 1-4 4v4L7 11h4l4-4 1-4Z" />
  <path d="m10 14-6 6" />
</svg>
