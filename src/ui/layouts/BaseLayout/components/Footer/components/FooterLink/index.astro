---
import type { Props } from '@/ui/layouts/BaseLayout/components/Footer/components/FooterLink/types'

const { label, tooltip = label, tooltipId, tooltipAlign = 'end', desktopOnly = false, ...attributes } = Astro.props
---

<a
  class:list={['footer__item', { 'footer__item--desktop': desktopOnly }]}
  {...attributes}
  aria-label={label}
  aria-describedby={tooltipId}
>
  <slot />
  <span
    class:list={['footer__tooltip', { 'footer__tooltip--start': tooltipAlign === 'start' }]}
    id={tooltipId}
    role="tooltip"
    >{tooltip}</span
  >
</a>
