---
import { GITHUB_REPOSITORY_URL } from '@/core/constants/github'
import CategoriesIcon from '@/ui/components/icons/CategoriesIcon/index.astro'
import CloudflareIcon from '@/ui/components/icons/CloudflareIcon/index.astro'
import CookieIcon from '@/ui/components/icons/CookieIcon/index.astro'
import GitHistoryIcon from '@/ui/components/icons/GitHistoryIcon/index.astro'
import GithubIcon from '@/ui/components/icons/GithubIcon/index.astro'
import HomeIcon from '@/ui/components/icons/HomeIcon/index.astro'
import LegalNoticeIcon from '@/ui/components/icons/LegalNoticeIcon/index.astro'
import PreferencesIcon from '@/ui/components/icons/PreferencesIcon/index.astro'
import PrivacyIcon from '@/ui/components/icons/PrivacyIcon/index.astro'
import WritePostIcon from '@/ui/components/icons/WritePostIcon/index.astro'
import CommitHistory from '@/ui/layouts/BaseLayout/components/Footer/components/CommitHistory/index.astro'
import FooterLink from '@/ui/layouts/BaseLayout/components/Footer/components/FooterLink/index.astro'
import type { Props } from '@/ui/layouts/BaseLayout/components/Footer/types'
import { getFooterNavigationState } from '@/ui/layouts/BaseLayout/components/Footer/utils/getFooterNavigationState'
import { paths } from '@/ui/routes/paths'
import '@/ui/layouts/BaseLayout/components/Footer/styles.css'

const { commits } = Astro.props
const { homeCurrent, categoriesCurrent, publishingGuideCurrent, cookiesCurrent, privacyCurrent, legalNoticeCurrent } =
  getFooterNavigationState(Astro.url.pathname)
---

<footer class="footer">
  <div class="footer__group">
    <button
      class="footer__item footer__item--history"
      type="button"
      commandfor="commit-history"
      command="show-modal"
      aria-label="Abrir historial de Git"
      aria-describedby="footer-history-tooltip"
    >
      <GitHistoryIcon class="footer__icon" />
      <span class="footer__tooltip footer__tooltip--start" id="footer-history-tooltip" role="tooltip"
        >Historial de commits</span
      >
    </button>
    <button
      class="footer__item"
      type="button"
      aria-label="Preferencias de cookies"
      aria-describedby="footer-preferences-tooltip"
      aria-haspopup="dialog"
      aria-controls="cookie-preferences"
      data-cookie-preferences
      hidden
    >
      <PreferencesIcon class="footer__icon" />
      <span class="footer__tooltip footer__tooltip--start" id="footer-preferences-tooltip" role="tooltip"
        >Preferencias de cookies</span
      >
    </button>
    <FooterLink
      href={paths.publishingGuide}
      label="Cómo escribir un post"
      tooltip="Cómo escribir un post"
      tooltipId="footer-new-post-tooltip"
      tooltipAlign="start"
      aria-current={publishingGuideCurrent}
    >
      <WritePostIcon class="footer__icon" />
    </FooterLink>
  </div>
  <nav class="footer__group" aria-label="Navegación del footer">
    <FooterLink href={paths.home} label="Inicio" tooltipId="footer-home-tooltip" aria-current={homeCurrent}>
      <HomeIcon class="footer__icon" />
    </FooterLink>
    <FooterLink
      href={paths.categories}
      label="Categorías"
      tooltip="Ver categorías"
      tooltipId="footer-categories-tooltip"
      aria-current={categoriesCurrent}
    >
      <CategoriesIcon class="footer__icon" />
    </FooterLink>
    <FooterLink
      href={paths.cookies}
      label="Política de cookies"
      tooltipId="footer-cookies-tooltip"
      aria-current={cookiesCurrent}
    >
      <CookieIcon class="footer__icon" />
    </FooterLink>
    <FooterLink
      href={paths.privacy}
      label="Política de privacidad"
      tooltipId="footer-privacy-tooltip"
      aria-current={privacyCurrent}
    >
      <PrivacyIcon class="footer__icon" />
    </FooterLink>
    <FooterLink
      href={paths.legalNotice}
      label="Aviso legal"
      tooltipId="footer-legal-notice-tooltip"
      aria-current={legalNoticeCurrent}
    >
      <LegalNoticeIcon class="footer__icon" />
    </FooterLink>
    <FooterLink
      href={GITHUB_REPOSITORY_URL}
      label="Repositorio"
      tooltipId="footer-github-tooltip"
      target="_blank"
      rel="noopener noreferrer"
    >
      <GithubIcon class="footer__icon" />
    </FooterLink>
    <FooterLink
      href="https://one.one.one.one/"
      label="Cloudflare"
      tooltip="Anti bloqueos de LaLiga"
      tooltipId="footer-cloudflare-tooltip"
      target="_blank"
      rel="noopener noreferrer"
    >
      <CloudflareIcon class="footer__icon" />
    </FooterLink>
  </nav>
</footer>
<CommitHistory commits={commits} />

<script>
import { initializePostTemplate } from '@/ui/utils/initializePostTemplate'

initializePostTemplate()
</script>
