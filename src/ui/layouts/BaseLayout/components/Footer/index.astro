---
import { site } from '@/ui/config/site'
import { paths } from '@/ui/routes/paths'
import '@/ui/layouts/BaseLayout/components/Footer/styles.css'

const year = new Date().getUTCFullYear()
---

<footer class="footer">
  <p class="footer__copyright">{site.title} © {year}</p>
  <nav aria-label="Navegación del pie">
    <a class="footer__link" href={paths.categories}>Categorías</a>
    <a class="footer__link" target="_blank" href={paths.rss}>RSS</a>
  </nav>
</footer>
