---
import { GITHUB_URL } from '@/core/constants/github'
import blogImage from '@/ui/assets/social/iadev.png'
import { site } from '@/ui/config/site'
import { POST_SOCIAL_IMAGES } from '@/ui/constants/postSocialImages'
import type { Props } from '@/ui/layouts/BaseLayout/components/SeoMetadata/types'
import { getSeoMetadata } from '@/ui/layouts/BaseLayout/components/SeoMetadata/utils/getSeoMetadata'
import { serializeStructuredData } from '@/ui/layouts/BaseLayout/components/SeoMetadata/utils/serializeStructuredData'

import { paths } from '@/ui/routes/paths'
import { getPostSocialImage } from '@/ui/utils/getPostSocialImage'

const { title, description = site.description, article, socialImage, noIndex = false } = Astro.props
const { pageTitle, socialTitle, canonical, image, structuredData } = getSeoMetadata({
  pathname: Astro.url.pathname,
  title,
  description,
  article,
  socialImage,
  fallbackImage: blogImage,
  articleImage: article ? getPostSocialImage(POST_SOCIAL_IMAGES, article.post.id) : undefined,
})
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content="es_ES" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image.url} />
<meta property="og:image:type" content={image.type} />
<meta property="og:image:width" content={image.width.toString()} />
<meta property="og:image:height" content={image.height.toString()} />
<meta property="og:image:alt" content={image.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.url} />
<meta name="twitter:image:alt" content={image.alt} />
{article && (
  <>
    <meta name="author" content={article.author.name} />
    {article.author.id !== 'default' && (
      <meta property="article:author" content={`${GITHUB_URL}/${article.author.id}`} />
    )}
    <meta property="article:published_time" content={article.post.published_at.toISOString()} />
    {article.post.updated_at && (
      <meta property="article:modified_time" content={article.post.updated_at.toISOString()} />
    )}
  </>
)}
<link rel="alternate" type="application/rss+xml" title={site.title} href={paths.rss} />
{!noIndex && <script type="application/ld+json" set:html={serializeStructuredData(structuredData)} />}
