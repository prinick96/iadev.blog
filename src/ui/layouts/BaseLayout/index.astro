---
import regularFont from '@/ui/assets/fonts/ibm-plex-mono/ibm-plex-mono-latin-400-normal.woff2?url'
import BackToTop from '@/ui/layouts/BaseLayout/components/BackToTop/index.astro'
import Footer from '@/ui/layouts/BaseLayout/components/Footer/index.astro'
import SaasIsDead from '@/ui/layouts/BaseLayout/components/SaasIsDead/index.astro'
import SeoMetadata from '@/ui/layouts/BaseLayout/components/SeoMetadata/index.astro'
import Topnav from '@/ui/layouts/BaseLayout/components/Topnav/index.astro'
import type { Props } from '@/ui/layouts/BaseLayout/types'
import '@/ui/styles/fonts.css'
import '@/ui/styles/global.css'
import '@/ui/styles/view-transitions.css'
import '@/ui/layouts/BaseLayout/styles.css'

const {
  title,
  description,
  article,
  noIndex,
  showDescription = false,
  showHeader = true,
  centerContent = false,
  commits,
} = Astro.props
---

<!doctype html>
<html lang="es" class="site-document">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoMetadata title={title} description={description} article={article} noIndex={noIndex} />
    <meta name="theme-color" content="#0c0d12" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=1" />
    <link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="site-shell" id="page-top" tabindex="-1">
      <div class:list={['site-shell__content', { 'site-shell__content--centered': centerContent }]}>
        {showHeader && <Topnav showDescription={showDescription} />}
        <main class:list={['site-shell__main', { 'site-shell__main--centered': centerContent }]}>
          <slot />
        </main>
      </div>
      <Footer commits={commits} />
      <BackToTop />
      <SaasIsDead />
    </div>
  </body>
</html>
