    {
      "id": "layers",
      "label": "Capas y contratos",
      "focus": ["content", "adapters", "ports", "routes", "composition", "application", "domain"],
      "note": "Las rutas de Astro conectan la presentación con los casos de uso. El dominio define los datos, los puertos describen las operaciones y los adaptadores resuelven el acceso a cada servicio."
    },
    {
      "id": "generation",
      "label": "Generación estática",
      "focus": ["routes", "static_paths", "render", "github_api", "presentation", "compilers", "generators", "dist"],
      "note": "El build carga el contenido, aplica las reglas del blog y genera HTML, gráficos, imágenes sociales y feeds. Los componentes reciben los datos y el Markdown ya preparado, sin repetir ese trabajo en cada visita."
    },
    {
      "id": "campaigns",
      "label": "Turso y campaña Brevo",
      "focus": ["static_paths", "register", "turso", "newsletter", "brevo_campaign", "render"],
      "note": "Con las notificaciones activadas, Turso registra los artículos nuevos y Brevo recibe una campaña con sus enlaces antes de que termine el build. El registro evita repetir IDs entre builds, pero no guarda el estado de entrega del correo."
    },
    {
      "id": "delivery",
      "label": "Entrega y Cloudflare",
      "focus": ["dist", "pages", "reader", "r2", "dns", "analytics"],
      "note": "Pages sirve las páginas generadas, R2 almacena imágenes, DNS resuelve el dominio y Analytics reúne las estadísticas del blog. La lectura del contenido no necesita un servidor de aplicación."
    },
    {
      "id": "subscription",
      "label": "Suscripción en navegador",
      "focus": ["reader", "subscription", "turnstile", "brevo_form"],
      "note": "El formulario se ejecuta en el navegador: obtiene un token de Turnstile y envía la suscripción a Brevo. Es un flujo distinto del envío de campañas durante el build y no necesita un backend propio."
    }
  ]
