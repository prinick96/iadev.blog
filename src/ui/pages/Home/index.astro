---
import PostThumbnail from '@/ui/components/PostThumbnail/index.astro'
import BaseLayout from '@/ui/layouts/BaseLayout/index.astro'
import Pagination from '@/ui/pages/Home/components/Pagination/index.astro'
import type { Props } from '@/ui/pages/Home/types'
import { getPostPath } from '@/ui/routes/getPostPath'
import { formatDate } from '@/ui/utils/formatDate'
import '@/ui/pages/Home/styles.css'

const { posts, currentPage, totalPages } = Astro.props
const title = currentPage > 1 ? `Página ${currentPage}` : undefined
---

<BaseLayout title={title} showDescription>
  <section class="home" aria-label="Últimos artículos">
    {posts.length === 0 ? (
      <p class="home__empty">Todavía no hay artículos publicados. La IA sigue pensando.</p>
    ) : (
      <ul class="home__posts">
        {posts.map((post, index) => (
          <li class="home__item">
            <a class="home__post" href={getPostPath(post.id)}>
              <time class="home__date" datetime={post.published_at.toISOString()}>
                {formatDate(post.published_at)}
              </time>
              <div class="home__summary">
                <h2 class="home__title">{post.title}</h2>
                <p class="home__description">{post.description}</p>
              </div>
              <span class="home__thumbnail">
                <PostThumbnail post={post} loading={index === 0 ? 'eager' : 'lazy'} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <Pagination currentPage={currentPage} totalPages={totalPages} />
  </section>
</BaseLayout>
