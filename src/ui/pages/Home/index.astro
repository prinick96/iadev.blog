---
import PostList from '@/ui/components/PostList/index.astro'
import BaseLayout from '@/ui/layouts/BaseLayout/index.astro'
import Pagination from '@/ui/pages/Home/components/Pagination/index.astro'
import type { Props } from '@/ui/pages/Home/types'
import '@/ui/pages/Home/styles.css'

const { posts, currentPage, totalPages } = Astro.props
const title = currentPage > 1 ? `Página ${currentPage}` : undefined
---

<BaseLayout title={title} showDescription>
  <section class="home" aria-label="Últimos artículos">
    <PostList posts={posts} />
    <Pagination currentPage={currentPage} totalPages={totalPages} />
  </section>
</BaseLayout>
