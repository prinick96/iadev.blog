---
import { GITHUB_URL } from '@/core/constants/github'
import type { Props } from '@/ui/pages/Post/components/AuthorInfo/components/AuthorProfile/types'

const { author, image } = Astro.props
const profileUrl = `${GITHUB_URL}/${author.id}`
---

<a
  class="author-info__link author-info__link--avatar"
  href={profileUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Perfil de ${author.name} en GitHub (se abre en otra pestaña)`}
>
  <span class="author-info__avatar" style={{ '--author-avatar': `url("${image.src}")` }} aria-hidden="true"></span>
</a>
<div>
  <p class="author-info__name">
    <a class="author-info__link" href={profileUrl} target="_blank" rel="noopener noreferrer">{author.name}</a>
  </p>
  <div class="author-info__bio" set:html={author.bio}></div>
</div>
