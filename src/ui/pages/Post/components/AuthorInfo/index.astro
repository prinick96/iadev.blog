---
import AnonymousAuthor from '@/ui/pages/Post/components/AuthorInfo/components/AnonymousAuthor/index.astro'
import AuthorProfile from '@/ui/pages/Post/components/AuthorInfo/components/AuthorProfile/index.astro'
import type { Props } from '@/ui/pages/Post/components/AuthorInfo/types'
import { getAuthorAvatar } from '@/ui/pages/Post/components/AuthorInfo/utils/getAuthorAvatar'
import '@/ui/pages/Post/components/AuthorInfo/styles.css'

const { author } = Astro.props

const image = await getAuthorAvatar(author.id, author.avatar)
---

<div class="author-info">
  {author.id === 'default' ? (
    <AnonymousAuthor author={author} image={image} />
  ) : (
    <AuthorProfile author={author} image={image} />
  )}
</div>
