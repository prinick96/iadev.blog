---
import Share from '@/ui/components/Share/index.astro'
import VibecoderZone from '@/ui/pages/Post/components/PostFooter/components/VibecoderZone/index.astro'
import WritePost from '@/ui/pages/Post/components/PostFooter/components/WritePost/index.astro'
import type { Props } from '@/ui/pages/Post/components/PostFooter/types'
import '@/ui/pages/Post/components/PostFooter/styles.css'

const { postUrl, postTitle } = Astro.props
---

<footer class="post-footer">
  <VibecoderZone postUrl={postUrl} />
  <Share id="post-share" url={postUrl} title={postTitle} />
  <WritePost />
</footer>
