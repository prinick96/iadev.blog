---
import ArrowLeftIcon from '@/ui/components/icons/ArrowLeftIcon/index.astro'
import MarkdownContent from '@/ui/components/MarkdownContent/index.astro'
import PostMetrics from '@/ui/components/PostMetrics/index.astro'
import PostThumbnail from '@/ui/components/PostThumbnail/index.astro'
import { site } from '@/ui/config/site'
import AuthorInfo from '@/ui/pages/Post/components/AuthorInfo/index.astro'
import PostFooter from '@/ui/pages/Post/components/PostFooter/index.astro'
import type { Props } from '@/ui/pages/Post/types'
import { getCategoryPath } from '@/ui/routes/getCategoryPath'
import { paths } from '@/ui/routes/paths'
import { formatDate } from '@/ui/utils/formatDate'
import '@/ui/pages/Post/styles.css'

const { post, author, categories } = Astro.props
const postUrl = new URL(Astro.url.pathname, site.url).href
---

<article class="post">
  <div class="post__intro">
    <a class="post__back" href={paths.home}>
      <ArrowLeftIcon class="post__back-icon" />
      Inicio
    </a>
  </div>
  <header class="post__header">
    <div class="post__heading">
      <h1 class="post__title">{post.title}</h1>
      <div class="post__metadata">
        {categories.length > 0 && (
          <ul class="post__categories" aria-label="Categorías del artículo">
            {categories.map((category) => (
              <li>
                <a class="post__category" href={getCategoryPath(category.id)}>
                  {category.name}
                </a>
              </li>
            ))}
          </ul>
        )}
        <PostMetrics post={post} />
      </div>
    </div>
    <time class="post__date" datetime={post.published_at.toISOString()}>{formatDate(post.published_at)}</time>
    <div class="post__thumbnail"><PostThumbnail post={post} loading="eager" /></div>

    {post.updated_at && (
      <p class="post__updated">
        Actualizado el <time datetime={post.updated_at.toISOString()}>{formatDate(post.updated_at)}</time>
      </p>
    )}
  </header>
  <div class="post__author">
    <AuthorInfo author={author} />
  </div>
  <MarkdownContent class="post__content">
    <slot />
    <PostFooter postUrl={postUrl} postTitle={post.title} />
  </MarkdownContent>
</article>
